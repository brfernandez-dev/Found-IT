# Copy this file to .env and fill in your local values.
# Never commit the real .env file.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=found_it

SESSION_SECRET=replace-me-with-a-long-random-string

# Set to "production" when deploying. The app then refuses to start without
# a real SESSION_SECRET and marks the session cookie Secure over HTTPS.
NODE_ENV=development

# Behind a reverse proxy (Nginx, Render, Railway...) set to 1 so client IPs
# (used by the login rate limiter) and HTTPS detection are correct.
# TRUST_PROXY=1
