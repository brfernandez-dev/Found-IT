<% if (!isAdminArea) { %>
<footer class="site-footer">
  <div class="container foot-row">
    <div class="brand">
      <img src="/images/cspc-logo.png" alt="" class="brand-logo">
      <span class="brand-lockup">
        <span class="brand-name">Found IT!</span>
        <span class="brand-caption">CSPC CAMPUS LOST &amp; FOUND</span>
      </span>
    </div>

    <p class="foot-copy">
      © <%= new Date().getFullYear() %> Camarines Sur Polytechnic Colleges · Found IT!
    </p>

    <nav class="foot-links" aria-label="Footer">
      <a href="/about">About</a>
      <a href="/how-it-works">How it works</a>
      <a href="/help">Help</a>
    </nav>
  </div>
</footer>
<% } else { %>
  </div>
</div>
<% } %>

<script src="/js/theme.js" defer></script>
<script src="/js/modal.js" defer></script>
<script src="/js/enhance.js" defer></script>
<% if (!isAdminArea) { %>
<script src="/js/student-nav.js" defer></script>
<% } %>
<% if (currentPath === '/profile') { %>
<script src="/js/profile.js" defer></script>
<% } %>
<% if (isAdminArea) { %>
<script src="/js/admin-sidebar.js" defer></script>
<% } %>

</body>
</html>