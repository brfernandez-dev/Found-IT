<%- include('../partials/head') %>

<%- include('../partials/nav') %>

<style>
  /* Lost & Found card refinements */
  .lost-found-card {
    font-family: "Trebuchet MS", Arial, sans-serif;
  }

  .lost-found-card .item-visual {
    height: 190px;
    padding: 12px;
    background: #f7fafc;
  }

  .lost-found-card .item-visual img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    border-radius: 6px;
  }

  .lost-found-card .lost-found-body h3,
  .lost-found-card .item-location,
  .lost-found-card .item-card-footer,
  .lost-found-card .item-view-link,
  .lost-found-card .item-status {
    font-family: "Trebuchet MS", Arial, sans-serif;
  }

  .lost-found-card .lost-found-body h3 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lost-found-card .item-status,
  .lost-found-card .item-type-badge {
    font-family: Arial, sans-serif;
  }

  @media (max-width: 600px) {
    .lost-found-card .item-visual {
      height: 175px;
    }
  }
</style>

<%
  function filterUrl(overrides) {

    const merged = Object.assign(
      {},
      filters || {},
      overrides || {}
    );

    const parts = [];

    Object.keys(merged).forEach(function (k) {

      const v = merged[k];

      if (
        v !== undefined &&
        v !== null &&
        v !== ''
      ) {
        parts.push(
          encodeURIComponent(k) +
          '=' +
          encodeURIComponent(v)
        );
      }

    });

    return '/items' +
      (parts.length
        ? '?' + parts.join('&')
        : '');
  }
%>




<section class="section campus-interior-section">

  <div class="container">

    <%- include('../partials/online-users') %>
    <!-- ========================================= -->
    <!-- SEARCH -->
    <!-- ========================================= -->

    <form
      class="search-bar"
      method="GET"
      action="/items"
    >

      <div class="search-intro">

        <span class="icon-circle" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="10.8" cy="10.8" r="6.8"></circle>
            <path d="m16 16 4.2 4.2"></path>
          </svg>
        </span>

        <div>

          <strong>
            Find an item
          </strong>

          <span>
            Search by name, description, location, or reference number.
          </span>

        </div>

      </div>


      <div class="search-form">

        <input
          type="search"
          name="q"
          placeholder="e.g. black wallet, library, REF-2025..."
          value="<%= (filters && filters.q) || '' %>"
        >


        <select name="category">

          <option value="">
            All categories
          </option>

          <% categories.forEach(function (c) { %>

            <option
              value="<%= c %>"
              <%= (filters && filters.category === c)
                ? 'selected'
                : '' %>
            >
              <%= c %>
            </option>

          <% }); %>

        </select>


        <select name="status">

          <option value="">
            Any status
          </option>

          <option
            value="unclaimed"
            <%= (filters && filters.status === 'unclaimed')
              ? 'selected'
              : '' %>
          >
            Unclaimed
          </option>

          <option
            value="claim_pending"
            <%= (filters && filters.status === 'claim_pending')
              ? 'selected'
              : '' %>
          >
            Pending
          </option>

          <option
            value="claimed"
            <%= (filters && filters.status === 'claimed')
              ? 'selected'
              : '' %>
          >
            Claimed
          </option>

          <option
            value="returned"
            <%= (filters && filters.status === 'returned')
              ? 'selected'
              : '' %>
          >
            Returned
          </option>

        </select>


        <button
          class="btn btn-primary"
          type="submit"
        >
          Search
        </button>

      </div>

    </form>



    <!-- ========================================= -->
    <!-- FILTERS -->
    <!-- ========================================= -->

    <div class="filter-pills">

      <a
        class="pill-filter <%= (filters && !filters.type)
          ? 'active'
          : '' %>"
        href="<%= filterUrl({ type: '' }) %>"
      >
        All
      </a>


      <a
        class="pill-filter <%= (filters && filters.type === 'lost')
          ? 'active'
          : '' %>"
        href="<%= filterUrl({ type: 'lost' }) %>"
      >
        Lost
      </a>


      <a
        class="pill-filter <%= (filters && filters.type === 'found')
          ? 'active'
          : '' %>"
        href="<%= filterUrl({ type: 'found' }) %>"
      >
        Found
      </a>


      <span class="count-note muted">

        <%= items.length %>
        result<%= items.length === 1 ? '' : 's' %>

      </span>

    </div>



    <!-- ========================================= -->
    <!-- NO RESULTS -->
    <!-- ========================================= -->

    <% if (!items.length) { %>

      <div class="empty">

        <p>
          No items match your search.
        </p>

        <a
          class="btn btn-ghost"
          href="/items"
        >
          Clear filters
        </a>

      </div>


    <% } else { %>


      <!-- ========================================= -->
      <!-- ITEM GRID -->
      <!-- ========================================= -->

      <div class="recent-grid lost-found-grid">

        <% items.forEach(function (item) { %>

          <a
            class="item-card lost-found-card"
            href="/items/<%= item.id %>"
          >

            <div class="item-visual item-thumb-<%= item.type %>">
              <% if (item.image_url) { %>
                <img
                  src="<%= item.image_url %>"
                  alt="Photo of <%= item.title %>"
                  loading="lazy"
                >
              <% } else { %>
                <div class="item-no-photo" aria-hidden="true">
                  <span class="item-no-photo-icon"><%= item.type === 'lost' ? '⌕' : '✓' %></span>
                  <span>No photo available</span>
                </div>
              <% } %>

              <span class="item-type-badge <%= item.type === 'lost' ? 'is-lost' : 'is-found' %>">
                <%= item.type === 'lost' ? 'Lost item' : 'Found item' %>
              </span>
            </div>

            <div class="item-body lost-found-body">

              <div class="item-card-topline">
                <span class="item-status status-<%= item.status %>">
                  <%= statusLabel(item.status) %>
                </span>
              </div>

              <h3><%= item.title %></h3>

              <div class="item-location">
                <span class="item-meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="2.5"></circle>
                  </svg>
                </span>
                <span><%= item.location || 'Location not specified' %></span>
              </div>

              <div class="item-poster">
                <% if (currentUser) { %>
                  <span class="item-poster-avatar" aria-hidden="true"><%= String(item.reporter_name || '?').trim().charAt(0).toUpperCase() %></span>
                  <span>Posted by <strong><%= item.reporter_name || 'A student' %></strong></span>
                <% } else { %>
                  <span>Posted by <strong>a CSPC member</strong></span>
                <% } %>
              </div>

              <div class="item-card-footer">
                <span>
                  <%= item.type === 'lost' ? 'Reported as lost' : 'Reported as found' %>
                </span>
                <% if (item.reference_no) { %>
                  <span class="item-reference"><%= item.reference_no %></span>
                <% } %>
              </div>

              <span class="item-view-link">
                View details <span aria-hidden="true">→</span>
              </span>

            </div>

          </a>

        <% }); %>

      </div>


    <% } %>

  </div>

</section>


<%- include('../partials/foot') %>