include('../partials/flash') %>

<section class="section campus-interior-section">
  <div class="container narrow">
    <div class="campus-help-content">
      <h2>Browsing the campus board</h2>
      <p>
        Use <a href="/items">Campus board</a> or the homepage search. Filter by
        type (lost / found), category, and status.
      </p>

      <h2>Reporting an item</h2>
      <p>
        You must <a href="/signup">sign up</a> or
        <a href="/login">log in</a> before reporting. Then click
        <strong>Report an item</strong> and fill in the form.
      </p>

      <h2>After you report</h2>
      <p>
        You can delete your own report from its detail page. If you find what
        you lost, ask staff to mark it <strong>returned</strong>.
      </p>

      <h2>Lost vs Found</h2>
      <ul>
        <li><strong>Lost</strong> — you lost something and want it back.</li>
        <li>
          <strong>Found</strong> — you found something and want to return it.
        </li>
      </ul>

      <h2>Still stuck?</h2>
      <p>
        Contact campus reception or email
        <a href="mailto:help@reunite.local">help@reunite.local</a>.
      </p>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
