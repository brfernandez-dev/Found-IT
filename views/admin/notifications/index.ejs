<%- include("../partials/head") %>

<%- include("../partials/nav") %>
<%- include("../partials/flash") %>


<%
  // Who sent the notification: a student (name + photo), another staff
  // member, or the system (no sender) which shows as Found IT! Admin.
  function senderOf(n) {
    if (n.sender_name && n.sender_role === "user") {
      return { name: n.sender_name, badge: "Student", kind: "student", image: n.sender_image };
    }
    if (n.sender_name && n.sender_role === "staff") {
      return { name: n.sender_name, badge: "Admin", kind: "admin", image: n.sender_image };
    }
    return { name: "Found IT! Admin", badge: "System", kind: "admin", image: null };
  }

  // "Someone submitted a claim..." -> "Submitted a claim..." (name is shown above).
  function messageOf(n, sender) {
    var text = String(n.message || "");
    if (sender.kind === "student" && /^Someone /.test(text)) {
      text = text.replace(/^Someone /, "");
      text = text.charAt(0).toUpperCase() + text.slice(1);
    }
    return text;
  }

  function initials(name) {
    return String(name || "?").trim().split(/\s+/).slice(0, 2)
      .map(function (part) { return part.charAt(0).toUpperCase(); }).join("") || "?";
  }

  function timeAgo(value) {
    var seconds = Math.floor((Date.now() - new Date(value).getTime()) / 1000);
    if (seconds < 60) return "Just now";
    var minutes = Math.floor(seconds / 60);
    if (minutes < 60) return minutes + "m ago";
    var hours = Math.floor(minutes / 60);
    if (hours < 24) return hours + "h ago";
    var days = Math.floor(hours / 24);
    if (days < 7) return days + "d ago";
    return new Date(value).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
  }

  function groupOf(value) {
    var date = new Date(value);
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var yesterday = new Date(today); yesterday.setDate(today.getDate() - 1);
    if (date >= today) return "Today";
    if (date >= yesterday) return "Yesterday";
    return "Earlier";
  }

  var lastGroup = null;
%>

<main class="<%= currentUser && currentUser.role === 'staff' ? 'admin-content admin-page admin-notifications-page' : 'container notifications-container' %>">
  <% if (currentUser && currentUser.role === 'staff') { %>
    <section class="admin-page-header admin-inner-page-header"><div><span class="admin-eyebrow">CSPC · STAFF CONSOLE</span><h1>Notifications</h1><p>Review claim requests and keep track of updates from the campus community.</p></div></section>
  <% } else { %><h1>Notifications</h1><% } %>


  <% if (pendingReports && pendingReports.length) { %>
    <section class="admin-pending-notifications admin-notification-panel" id="pending-reports">
      <h2>Reports waiting for approval</h2>
      <p>New lost and found reports stay hidden from the campus board until you approve them.</p>
      <% pendingReports.forEach(function(report) { %>
        <article class="notification-card unread admin-claim-card report-review-card">
          <% if (report.image_url) { %><img class="report-review-thumb" src="<%= report.image_url %>" alt=""><% } %>
          <div class="report-review-info">
            <h3>
              <%= report.title %>
              <small>(<%= report.reference_no %>)</small>
              <span class="tag <%= report.type === 'lost' ? 'tag-claim_pending' : 'tag-returned' %>"><%= report.type === 'lost' ? 'Lost' : 'Found' %></span>
            </h3>
            <p><strong>Posted by:</strong> <%= report.reporter_name || 'Unknown' %><%= report.reporter_contact ? ' · ' + report.reporter_contact : '' %></p>
            <p><strong>Category:</strong> <%= report.category %> · <strong>Location:</strong> <%= report.location %></p>
            <p><strong>Description:</strong> <%= report.description %></p>
            <p><a href="/items/<%= report.id %>">Open full report →</a></p>
            <div class="notification-actions">
              <form method="POST" action="/admin/items/<%= report.id %>/review">
                <input type="hidden" name="decision" value="approved">
                <input type="hidden" name="returnTo" value="notifications">
                <button class="btn btn-primary" type="submit">Approve &amp; publish</button>
              </form>
              <form method="POST" action="/admin/items/<%= report.id %>/review" class="review-reject">
                <input type="hidden" name="decision" value="rejected">
                <input type="hidden" name="returnTo" value="notifications">
                <input type="text" name="note" maxlength="255" placeholder="Reason (optional)" aria-label="Reason for rejecting">
                <button class="btn btn-ghost" type="submit" onclick="return confirm('Reject this report?');">Reject</button>
              </form>
            </div>
          </div>
        </article>
      <% }); %>
    </section>
  <% } %>

  <% if (currentUser && currentUser.role === 'staff' && pendingClaims && pendingClaims.length) { %>
    <section class="admin-pending-notifications admin-notification-panel">
      <h2>Claims waiting for review</h2>
      <p>Student claims that need an admin decision.</p>
      <% pendingClaims.forEach(function(claim) { %>
        <article class="notification-card unread admin-claim-card">
          <h3><%= claim.item_name %> <small>(<%= claim.reference_no %>)</small></h3>
          <p><strong>Student:</strong> <%= claim.claimant_name %> · <%= claim.claimant_email %></p>
          <p><strong>Reason:</strong> <%= claim.reason %></p>
          <p><strong>Identifying detail:</strong> <%= claim.distinguishing_detail %></p>
          <% if (claim.extra_info) { %><p><strong>Extra information:</strong> <%= claim.extra_info %></p><% } %>
          <div class="notification-actions">
            <form method="POST" action="/admin/claims/<%= claim.id %>/review">
              <input type="hidden" name="decision" value="approved">
              <button class="btn btn-primary" type="submit">Approve claim</button>
            </form>
            <form method="POST" action="/admin/claims/<%= claim.id %>/review" onsubmit="return confirm('Reject this claim?');">
              <input type="hidden" name="decision" value="rejected">
              <button class="btn btn-ghost" type="submit">Reject claim</button>
            </form>
          </div>
        </article>
      <% }); %>
    </section>
  <% } %>

  <div class="notif-toolbar">
    <nav class="notif-tabs" aria-label="Filter notifications">
      <a href="/notifications" class="notif-tab <%= filter === 'all' ? 'active' : '' %>" <%- filter === 'all' ? 'aria-current="page"' : '' %>>All</a>
      <a href="/notifications?filter=unread" class="notif-tab <%= filter === 'unread' ? 'active' : '' %>" <%- filter === 'unread' ? 'aria-current="page"' : '' %>>
        Unread<% if (unreadCount > 0) { %> <span class="notif-tab-count"><%= unreadCount %></span><% } %>
      </a>
    </nav>

    <% if (unreadCount > 0) { %>
      <form method="POST" action="/notifications/read-all">
        <button type="submit" class="notif-mark-all">Mark all as read</button>
      </form>
    <% } %>
  </div>

  <% if (notifications.length > 0) { %>
    <div class="notif-list">
      <% notifications.forEach(function (n) {
           var sender = senderOf(n);
           var group = groupOf(n.created_at);
      %>
        <% if (group !== lastGroup) { lastGroup = group; %>
          <h2 class="notif-group"><%= group %></h2>
        <% } %>

        <a class="notif <%= n.is_read ? 'is-read' : 'is-unread' %>"
           href="/notifications/<%= n.id %>/open"
           aria-label="<%= (n.is_read ? '' : 'Unread. ') + sender.name + ': ' + n.message %>">

          <span class="notif-avatar notif-avatar--<%= sender.kind %>" aria-hidden="true">
            <% if (sender.image) { %>
              <img src="<%= sender.image %>" alt="">
            <% } else if (sender.kind === "admin") { %>
              <img src="/images/cspc-logo.png" alt="">
            <% } else { %>
              <%= initials(sender.name) %>
            <% } %>
          </span>

          <span class="notif-body">
            <span class="notif-from">
              <strong><%= sender.name %></strong>
              <span class="notif-badge notif-badge--<%= sender.kind %>"><%= sender.badge %></span>
            </span>
            <span class="notif-text"><%= messageOf(n, sender) %></span>
            <time class="notif-time" datetime="<%= new Date(n.created_at).toISOString() %>"
                  title="<%= new Date(n.created_at).toLocaleString() %>"><%= timeAgo(n.created_at) %></time>
          </span>

          <% if (n.item_image) { %>
            <img class="notif-thumb" src="<%= n.item_image %>" alt="" loading="lazy">
          <% } %>

          <% if (!n.is_read) { %>
            <span class="notif-dot" aria-hidden="true"></span>
          <% } %>
        </a>
      <% }); %>
    </div>

  <% } else if (!(pendingClaims && pendingClaims.length)) { %>
    <div class="notif-empty">
      <span class="notif-empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
      </span>
      <p><%= filter === "unread" ? "No unread notifications. You're all caught up!" : "You have no notifications yet." %></p>
    </div>
  <% } %>
</main>

<%- include("../partials/foot") %>