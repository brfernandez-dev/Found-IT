<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<section class="campus-page-hero">
  <div class="container">
    <span class="campus-page-kicker">CSPC · THE PROCESS</span>
    <h1>From report to return.</h1>
    <p>Three clear steps help campus members reconnect with their belongings safely.</p>
  </div>
</section>

<section class="section campus-interior-section">
  <div class="container">
    <div class="steps-grid">
      <article class="step-card campus-step-card">
        <span class="step-num">01</span>
        <h3>Report it</h3>
        <p>Tell the community what you've lost or found with a few simple details.</p>
      </article>
      <article class="step-card campus-step-card">
        <span class="step-num">02</span>
        <h3>Search &amp; connect</h3>
        <p>Browse reports and use smart filters to find a potential match.</p>
      </article>
      <article class="step-card campus-step-card">
        <span class="step-num">03</span>
        <h3>Reunite safely</h3>
        <p>Verify ownership privately and arrange a safe return.</p>
      </article>
    </div>
  </div>
</section>

